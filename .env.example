# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# NASA Earthdata Login bearer token (https://urs.earthdata.nasa.gov -> Generate Token)
EARTHDATA_TOKEN=your-earthdata-bearer-token

# OpenET API key (https://account.etdata.org -> API)
OPENET_API_KEY=your-openet-api-key

# Google Cloud project registered for Earth Engine (optional; Landsat falls back to
# Microsoft Planetary Computer when Earth Engine is not authenticated)
GEE_PROJECT_ID=your-gee-project-id
